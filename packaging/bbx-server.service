[Unit]
Description=Vigil BBX Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bbx

ExecStart=/bin/sh -c 'mkdir -p /opt/bbx/logs && /opt/bbx/bbx-server -config /opt/bbx/conf/config.yaml >> /opt/bbx/logs/app.log 2>&1'

Restart=always
RestartSec=5

LimitNOFILE=65535
LimitNPROC=65535

# PrivateTmp disabled: bbx-server needs to access real /tmp for log streaming
# and file operations. Enabling PrivateTmp would create a private mount
# namespace where /tmp is isolated from the system.
PrivateTmp=false

[Install]
WantedBy=multi-user.target